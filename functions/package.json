{
  "name": "low-value-content-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Checkout and fulfillment backend: Stripe Checkout, Printify production, Firestore order ledger",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,hosting",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "stripe": "^23.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "rimraf": "^6.1.4"
  }
}
