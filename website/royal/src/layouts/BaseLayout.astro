---
interface Props {
  title: string;
  description: string;
  current?: string;
}

const { title, description, current = "" } = Astro.props;
const nav = [
  ["realm", "/realm.html", "The Realm"],
  ["lineage", "/lineage.html", "The Lineage"],
  ["calendar", "/calendar.html", "Royal Calendar"],
  ["shop", "/shop.html", "The Regalia"],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1c2b" />
    <title>{title}</title>
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/assets/auth-gate.css" />
    <script is:inline src="/assets/env-config.js"></script>
    <script is:inline src="/assets/auth-gate.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand-lockup" href="/">
        <img class="brand-crown" src="/assets/royal-mark.svg" alt="" />
        <span><b>La Maison de Valebasse</b><small>Purveyed by Low Value Content</small></span>
      </a>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-navigation">Menu</button>
      <nav id="site-navigation" aria-label="Primary navigation">
        {nav.map(([id, href, label]) => <a href={href} aria-current={current === id ? "page" : undefined}>{label}</a>)}
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-brand">
        <a class="footer-house" href="/" aria-label="La Maison de Valebasse home">
          <img src="/assets/royal-mark.svg" alt="" />
          <span><b>La Maison de Valebasse</b><small>La Très Ancienne et Sérénissime</small></span>
        </a>
        <p><i>Low Value Content</i><br />Purveyor to the House and official issuer of its regalia.</p>
      </div>
      <div class="footer-column">
        <p class="footer-heading">The estate</p>
        <nav aria-label="Explore Valebasse">
          <a href="/realm.html">Realm</a>
          <a href="/lineage.html">Lineage</a>
          <a href="/calendar.html">Calendar</a>
          <a href="/shop.html">Regalia</a>
          <a href="/about.html">About</a>
        </nav>
      </div>
      <div class="footer-column">
        <p class="footer-heading">Practical matters</p>
        <nav aria-label="Legal and support">
          <a href="/support.html">Support</a>
          <a href="/terms.html">Terms</a>
          <a href="/cookies.html">Cookies</a>
          <a href="/privacy.html">Privacy</a>
        </nav>
      </div>
      <div class="footer-social">
        <p class="footer-heading">Follow the court</p>
        <div>
          <a href="/social.html#instagram" aria-label="Instagram plans"><img src="/assets/icon-instagram.svg" alt="" /></a>
          <a href="/social.html#tiktok" aria-label="TikTok plans"><img src="/assets/icon-tiktok.svg" alt="" /></a>
          <a href="/social.html#linkedin" aria-label="LinkedIn plans"><img src="/assets/icon-linkedin.svg" alt="" /></a>
        </div>
        <a class="social-note" href="/social.html">Social proclamations →</a>
      </div>
      <p class="legal">© 2026 Low Value Content, an imprint of Nelson Grey LLC. All rights reserved.</p>
    </footer>
    <script is:inline>
      const button = document.querySelector('.menu-button');
      const nav = document.querySelector('#site-navigation');
      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('open', !open);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --navy: #0d1c2b;
    --navy-2: #142b40;
    --ink: #17202a;
    --gold: #ba8d3a;
    --gold-light: #dabf83;
    --ivory: #f4eedf;
    --paper: #fbf7ed;
    --crimson: #852e34;
    --blue: #476e8f;
    --line: rgba(186, 141, 58, .42);
    --serif: Georgia, 'Times New Roman', serif;
    --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --script: 'Snell Roundhand', 'Apple Chancery', cursive;
  }
  * { box-sizing: border-box; }
  html { background: var(--navy); color: var(--ink); scroll-behavior: smooth; }
  body { margin: 0; background: var(--paper); font-family: var(--serif); }
  img { max-width: 100%; display: block; }
  a { color: inherit; }
  .skip-link { position: fixed; left: 1rem; top: -5rem; z-index: 30; background: white; padding: .75rem 1rem; }
  .skip-link:focus { top: 1rem; }
  .site-header { min-height: 92px; padding: 1rem clamp(1.25rem, 4vw, 4.5rem); display: flex; align-items: center; justify-content: space-between; gap: 2rem; background: var(--navy); color: var(--ivory); border-bottom: 1px solid rgba(218,191,131,.35); position: relative; z-index: 10; }
  .brand-lockup { display: flex; align-items: center; gap: .85rem; text-decoration: none; letter-spacing: .04em; }
  .brand-lockup b { display: block; text-transform: uppercase; font-size: .95rem; }
  .brand-lockup small { display: block; color: var(--gold-light); font-style: italic; margin-top: .2rem; }
  .brand-crown { width: 34px; height: 34px; object-fit: contain; }
  .site-header nav { display: flex; align-items: center; gap: 1.4rem; font-family: var(--sans); font-size: .78rem; text-transform: uppercase; letter-spacing: .12em; }
  .site-header nav a { color: rgba(244,238,223,.8); text-decoration: none; padding: .5rem 0; border-bottom: 1px solid transparent; }
  .site-header nav a:hover, .site-header nav a[aria-current='page'] { color: white; border-color: var(--gold); }
  .menu-button { display: none; border: 1px solid var(--gold); background: transparent; color: var(--ivory); padding: .65rem .9rem; font: inherit; }
  .site-footer { background: var(--navy); color: var(--ivory); padding: 4rem clamp(1.25rem, 5vw, 5rem) 2rem; display: grid; grid-template-columns: minmax(260px, 1.5fr) .7fr .8fr .8fr; gap: clamp(2rem, 4vw, 4.5rem); border-top: 4px double var(--gold); }
  .footer-brand { display: block; }
  .footer-house { display: flex; align-items: center; gap: .85rem; width: fit-content; text-decoration: none; }
  .footer-house img { width: 48px; height: 48px; }
  .footer-house b { display: block; color: var(--ivory); font-size: .95rem; font-weight: 400; letter-spacing: .06em; text-transform: uppercase; }
  .footer-house small { display: block; margin-top: .25rem; color: var(--gold-light); font-family: var(--script); font-size: .9rem; }
  .site-footer .footer-brand > p { max-width: 340px; margin-top: 2.75rem; font: 400 .65rem/1.55 var(--sans); }
  .footer-brand > p i { font-size: inherit; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .site-footer p { margin: 0; line-height: 1.55; color: rgba(244,238,223,.72); }
  .site-footer i { color: var(--gold-light); }
  .footer-heading { margin-bottom: 1rem !important; color: var(--gold-light) !important; font: 700 .66rem/1.3 var(--sans); letter-spacing: .16em; text-transform: uppercase; }
  .site-footer nav { display: grid; gap: .65rem; font-family: var(--sans); font-size: .78rem; }
  .site-footer nav a { text-decoration: none; }
  .site-footer nav a:hover, .site-footer nav a:focus-visible, .social-note:hover, .social-note:focus-visible { color: white; text-decoration: underline; text-underline-offset: 4px; }
  .footer-social > div { display: flex; gap: .65rem; }
  .footer-social > div a { width: 38px; height: 38px; border: 1px solid rgba(218,191,131,.45); border-radius: 50%; display: grid; place-items: center; }
  .footer-social > div a:hover, .footer-social > div a:focus-visible { background: var(--crimson); border-color: var(--gold-light); }
  .footer-social img { width: 19px; height: 19px; }
  .social-note { display: inline-block; margin-top: 1rem; color: rgba(244,238,223,.7); font: .72rem/1.4 var(--sans); text-decoration: none; }
  .legal { grid-column: 1 / -1; border-top: 1px solid rgba(255,255,255,.15); padding-top: 1.2rem; font: .72rem/1.5 var(--sans); }
  .eyebrow { font: 700 .72rem/1.3 var(--sans); text-transform: uppercase; letter-spacing: .18em; color: var(--crimson); }
  .script { font-family: var(--script); font-size: 1.35em; font-weight: 400; color: var(--crimson); }
  .latin { text-transform: uppercase; letter-spacing: .16em; font-size: .74rem; color: var(--gold); }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: .55rem; padding: .9rem 1.25rem; border: 1px solid var(--gold); background: var(--navy); color: white; text-decoration: none; font: 700 .75rem/1 var(--sans); letter-spacing: .11em; text-transform: uppercase; cursor: pointer; }
  .button:hover { background: var(--crimson); }
  .button.light { background: var(--ivory); color: var(--navy); }
  .button.ghost { background: transparent; color: var(--navy); }
  .section { padding: clamp(4rem, 8vw, 8rem) clamp(1.25rem, 6vw, 7rem); }
  .section-heading { max-width: 780px; margin-bottom: 3rem; }
  .section-heading h2 { font-size: clamp(2.3rem, 5vw, 5rem); line-height: .98; margin: .3rem 0 1rem; font-weight: 400; }
  .section-heading p:last-child { max-width: 620px; font-size: 1.1rem; line-height: 1.7; }
  @media (max-width: 800px) {
    .menu-button { display: block; }
    .site-header nav { display: none; position: absolute; left: 0; right: 0; top: 100%; padding: 1.25rem; background: var(--navy); flex-direction: column; align-items: stretch; border-top: 1px solid var(--line); }
    .site-header nav.open { display: flex; }
    .brand-lockup small { display: none; }
    .site-footer { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
    .legal { grid-column: 1; }
  }
  @media (max-width: 520px) {
    .site-footer { grid-template-columns: 1fr; }
    .footer-brand, .legal { grid-column: 1; }
  }
</style>
