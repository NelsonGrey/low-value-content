---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { hasRealmProvenance, lineage, products, productImage, type Product } from "../../data";

export function getStaticPaths() {
  return products.map((product) => ({ params: { id: product.id }, props: { product } }));
}

const { product } = Astro.props as { product: Product };
const image = productImage(product);
const rawFrontArt = "frontArtDisplay" in product.assets ? product.assets.frontArtDisplay : undefined;
const frontArt = rawFrontArt ? `/assets/${rawFrontArt.split("/").pop()}` : null;
const canBuy = product.commerceStatus === "test-sellable" && product.commerce.catalogKey;
const reignName = lineage.find((entry) => entry.id === product.reign)?.name ?? product.reign;
const realmConnected = hasRealmProvenance(product);
const isCommemoration = product.launchCollection === "Royal Commemorations";
const artSpecs: Record<string, { garment: string; inks: string }> = {
  "validate": { garment: "Warm white", inks: "Editorial black + notification red" },
  "thought-leader": { garment: "Warm white", inks: "Archive navy + antique gold" },
  "doomscrolling": { garment: "Oxblood", inks: "Warm ivory + antique gold" },
  "content-creator": { garment: "Warm white", inks: "Editorial black + status red" },
  "authentic-self": { garment: "Warm white", inks: "Editorial black + status red" },
  "optimized-shirt": { garment: "Warm white", inks: "Editorial black + status red" },
  "much-published": { garment: "Deep navy", inks: "Warm ivory + antique gold" },
  "order-blue-check": { garment: "Washed black", inks: "Appointment blue + antique gold" },
  "y2k-the-almost": { garment: "Oxblood", inks: "Warm ivory + millennium gold" },
  "saint-moth": { garment: "Warm ivory", inks: "Archive navy + antique gold" },
};
const artSpec = artSpecs[product.id];
---
<BaseLayout title={`${product.primaryCopy} | Low Value Content`} description={`${product.primaryCopy} — ${product.royalTreatment}. A Low Value Content apparel concept.`} current="shop">
  <article class="product-page">
    <div class:list={["product-visual", `art-${product.id}`, !image && "typographic"]}>
      {image ? <><img src={image} alt={`Exact front artwork for ${product.primaryCopy}`} /><span class="visual-label">Exact launch artwork · front print</span></> : <div><p>{product.latin}</p><h1>{product.primaryCopy}</h1><span class="script">{product.royalTreatment}</span></div>}
    </div>
    <div class="product-details">
      <p class="eyebrow">No. {String(product.position).padStart(2, "0")} · {product.launchCollection}</p>
      <h1>{product.primaryCopy}</h1>
      <p class="price">$32 <span>planned retail</span></p>
      <p class="treatment">{product.regaliaRole}</p>
      {product.latin && <p class="latin">{product.latin}</p>}
      {canBuy ? (
        <form class="buy-form" data-product={product.commerce.catalogKey} data-color="white">
          <label>Size<select name="size" required><option value="l" selected>L</option></select></label>
          <label>Quantity<select name="quantity"><option>1</option><option>2</option><option>3</option></select></label>
          <button class="button" type="submit">Proceed to secure test checkout</button>
          <p class="buy-note" role="status" aria-live="polite">Test configuration: White / L only. US shipping is $5.99.</p>
        </form>
      ) : (
        <div class="development-notice"><b>In development</b><p>This concept is not yet available for purchase. Production artwork, garment selection, sampling, and Printify variants remain to be approved.</p></div>
      )}
      <dl>
        <div><dt>Collection</dt><dd>{product.launchCollection}</dd></div>
        <div><dt>Launch print</dt><dd>Front only</dd></div>
        <div><dt>Realm intensity</dt><dd>{product.realmIntensity}</dd></div>
        {realmConnected && <div><dt>House</dt><dd>{product.house}</dd></div>}
        {realmConnected && <div><dt>{isCommemoration ? "Observed under" : "Archival reign"}</dt><dd>{reignName}</dd></div>}
        <div><dt>Creative status</dt><dd>{product.creativeStatus.replaceAll("-", " ")}</dd></div>
      </dl>
      {realmConnected ? (
        <section class="proclamation"><p class="eyebrow">{isCommemoration ? "From the Royal Archive" : `By authority of ${product.house}`}</p><blockquote>{product.realmIssue.proclamation}</blockquote><p class="title-line">Online provenance: <b>{product.realmIssue.office}</b> · <b>{product.realmIssue.wearerTitle}</b>.</p></section>
      ) : (
        <section class="independent-note"><p class="eyebrow">Outside the court</p><h2>No title. No House. No court authority required.</h2><p>The Realm may catalogue this observation, but the garment remains an independent Low Value Content notice.</p></section>
      )}
      <section class="provenance"><p class="script">The Launch Constitution</p><h2>The declaration must stand on the front alone.</h2><ol><li><b>One print area:</b> production starts front-only.</li><li><b>Selective ceremony:</b> seals, Latin, and heraldry appear only where the issue requires formal standing.</li><li><b>Extended provenance:</b> QR records, titles, and lineage begin online or in packaging—not as compulsory garment decoration.</li></ol></section>
    </div>
  </article>
  {frontArt && artSpec && (
    <section class="front-art-section">
      <div class="front-art-copy">
        <p class="eyebrow">Front-art prototype · Two inks</p>
        <h2>The regalia,<br /><span class="script">reduced to what prints.</span></h2>
        <p>This transparent 4500 × 5400 vector composition translates the Realm concept into one centered front print. It is editable artwork—not a flattened mockup—and deliberately excludes sleeve decoration, back copy, and a garment QR code.</p>
        <dl>
          <div><dt>Garment direction</dt><dd>{artSpec.garment}</dd></div>
          <div><dt>Ink direction</dt><dd>{artSpec.inks}</dd></div>
          <div><dt>Print locations</dt><dd>One · front only</dd></div>
          <div><dt>Next gate</dt><dd>Outline type, size to provider template, separate inks, sample and wash test</dd></div>
        </dl>
      </div>
    </section>
  )}
  {canBuy && <script is:inline src="/assets/checkout.js"></script>}
</BaseLayout>

<style>
  .product-page { display: grid; grid-template-columns: 1.08fr .92fr; min-height: calc(100vh - 92px); }
  .product-visual { position: relative; background: #e8dfce; padding: clamp(2rem, 5vw, 6rem); display: grid; place-items: center; }
  .product-visual img { width: 100%; max-height: 76vh; object-fit: contain; }
  .visual-label { position: absolute; left: clamp(1rem, 3vw, 2rem); bottom: clamp(1rem, 3vw, 2rem); padding: .55rem .7rem; background: rgba(244,238,223,.94); color: var(--navy); font: 700 .58rem/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; }
  .product-visual.typographic > div { border: 14px double var(--navy); width: min(640px, 100%); aspect-ratio: 4 / 5; display: flex; padding: 3rem; flex-direction: column; align-items: center; justify-content: center; text-align: center; background: var(--ivory); }
  .product-visual.typographic p { color: var(--gold); text-transform: uppercase; letter-spacing: .15em; }
  .product-visual.typographic h1 { color: var(--navy); font-size: clamp(2.5rem, 5vw, 5rem); text-transform: uppercase; line-height: .96; }
  .product-details { padding: clamp(3rem, 6vw, 7rem); align-self: center; }
  .product-details > h1 { font-size: clamp(3rem, 5vw, 5.5rem); line-height: .92; font-weight: 400; margin: 1rem 0 1.5rem; }
  .price { font-size: 1.5rem; border-bottom: 1px solid var(--line); padding-bottom: 1.2rem; }
  .price span { font: .7rem var(--sans); text-transform: uppercase; letter-spacing: .12em; color: #6d7378; }
  .treatment { font-size: 1.1rem; line-height: 1.7; }
  .buy-form { margin: 2rem 0; display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; padding: 1.5rem; background: #eee5d4; border: 1px solid var(--line); }
  .buy-form label { display: grid; gap: .4rem; font: 700 .7rem var(--sans); text-transform: uppercase; letter-spacing: .1em; }
  .buy-form select { padding: .8rem; border: 1px solid var(--gold); background: white; font: inherit; }
  .buy-form .button, .buy-note { grid-column: 1 / -1; }
  .buy-note { margin: 0; font: .75rem/1.5 var(--sans); }
  .development-notice { margin: 2rem 0; padding: 1.5rem; border: 1px solid var(--gold); background: var(--ivory); }
  .development-notice b { text-transform: uppercase; letter-spacing: .12em; font: 700 .72rem var(--sans); color: var(--crimson); }
  .development-notice p { line-height: 1.55; }
  dl { margin: 2rem 0; border-top: 1px solid var(--line); }
  dl div { display: grid; grid-template-columns: 140px 1fr; gap: 1rem; padding: .8rem 0; border-bottom: 1px solid var(--line); }
  dt { font: 700 .65rem var(--sans); text-transform: uppercase; letter-spacing: .1em; color: var(--crimson); }
  dd { margin: 0; text-transform: capitalize; }
  .proclamation { margin-top: 3rem; padding: 2rem; border: 1px solid var(--gold); background: #eee5d4; }
  .proclamation blockquote { margin: 1rem 0; font-size: 1.35rem; line-height: 1.45; }
  .title-line { margin-bottom: 0; font-size: .9rem; line-height: 1.6; }
  .independent-note { margin-top: 3rem; padding: 2rem; border-left: 4px solid var(--crimson); background: #eee5d4; }
  .independent-note h2 { margin: .5rem 0 1rem; font-size: 2rem; font-weight: 400; line-height: 1.1; }
  .independent-note p:last-child { margin-bottom: 0; line-height: 1.65; }
  .provenance { margin-top: 3rem; }
  .provenance h2 { font-size: 2rem; font-weight: 400; line-height: 1.1; }
  .provenance ol { padding-left: 1.2rem; line-height: 1.8; }
  .front-art-section { background: var(--ivory); border-top: 4px double var(--gold); }
  .art-much-published { background: #10263a; }
  .art-order-blue-check { background: #151515; }
  .art-y2k-the-almost { background: #7d2734; }
  .art-saint-moth { background: #f1e8d2; }
  .art-validate, .art-thought-leader, .art-content-creator, .art-authentic-self, .art-optimized-shirt { background: #f4eedf; }
  .art-doomscrolling { background: #7d2734; }
  .front-art-copy { max-width: 980px; padding: clamp(3rem, 7vw, 7rem); margin: auto; }
  .front-art-copy h2 { margin: .8rem 0 1.5rem; font-size: clamp(3rem, 5vw, 5.5rem); line-height: .94; font-weight: 400; }
  .front-art-copy > p:not(.eyebrow) { max-width: 680px; font-size: 1.08rem; line-height: 1.7; }
  .front-art-copy dl { margin-top: 2.5rem; }
  @media (max-width: 900px) { .product-page { grid-template-columns: 1fr; } }
</style>
