---
import BaseLayout from "../layouts/BaseLayout.astro";
import { observances } from "../data";

const eventCopy: Record<string, { year: string; line: string; latin?: string }> = {
  "01-01": { year: "1983", line: "ARPANET adopted TCP/IP and the interconnected realm received a common protocol." },
  "04-01": { year: "1998", line: "The Hyper Text Coffee Pot Control Protocol brought standards to the most essential network service." },
  "04-23": { year: "2005", line: "The first YouTube video was uploaded. Nineteen seconds became an economy." },
  "04-30": { year: "1993", line: "CERN placed the Web software in the public domain. The Web was free; other ways to pay followed." },
  "05-03": { year: "1978", line: "The earliest widely recognized spam email addressed the realm without invitation." },
  "05-11": { year: "1997", line: "Deep Blue defeated Garry Kasparov, beginning the first ceremonial observance of human obsolescence." },
  "06-29": { year: "2007", line: "The first iPhone went on sale and the infinite scroll moved within ignoring distance." },
  "09-09": { year: "1947", line: "An actual moth was found in the Mark II and entered the permanent peerage of technical history.", latin: "Primus casus verus" },
  "09-19": { year: "1982", line: "The sideways smiley supplied mandatory emotional context to digital correspondence." },
  "10-29": { year: "1969", line: "ARPANET attempted LOGIN, transmitted LO, and crashed before completing its first thought.", latin: "Initium interruptum" },
  "11-30": { year: "2022", line: "ChatGPT was introduced and the present generative reign began." },
  "12-31": { year: "1999", line: "The realm awaited the Millennium Pretender and discovered that successful prevention looks suspiciously uneventful.", latin: "Finis mundi dilatus" }
};
const months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
const eventDevices: Record<string, string> = {
  "01-01": "/assets/royal-mark.svg",
  "04-01": "/assets/order-jacquard.svg",
  "04-23": "/assets/house-influence.svg",
  "04-30": "/assets/royal-mark.svg",
  "05-03": "/assets/house-spam.svg",
  "05-11": "/assets/house-prompt.svg",
  "06-29": "/assets/house-scroll.svg",
  "09-09": "/assets/lineage-moth.svg",
  "09-19": "/assets/order-blue-check.svg",
  "10-29": "/assets/lineage-lo.svg",
  "11-30": "/assets/house-prompt.svg",
  "12-31": "/assets/lineage-y2k.svg",
};
---
<BaseLayout title="Royal Calendar | Low Value Content" description="Annual observances commemorating bugs, spam, the Web, infinite scrolling, Y2K, artificial intelligence, and other events of state." current="calendar">
  <header class="calendar-hero">
    <p class="script">Dates of Ceremonial Importance</p>
    <h1>The Royal Calendar</h1>
    <p>Because history is easier to monetize when it occurs on the same date every year.</p>
  </header>
  <section class="calendar-preface">
    <p class="eyebrow">The annual cycle</p>
    <h2>Twelve observances.<br /><span class="script">No ordinary days.</span></h2>
    <p>The court year proceeds from Universal Connectivity through the Vigil of the Missing Digits. Each observance retains its historical device, established date, and present commemorative standing.</p>
  </section>
  <section class="calendar-list">
    {observances.map((event) => {
      const [month, day] = event.monthDay.split("-").map(Number);
      const detail = eventCopy[event.monthDay];
      return (
        <article class:list={[event.monthDay === "12-31" && "y2k"]}>
          <div class="card-header">
            <time datetime={`2026-${event.monthDay}`}><span>{String(day).padStart(2, "0")}</span><b>{months[month - 1]}</b></time>
            <img class="event-device" src={eventDevices[event.monthDay]} alt="" />
          </div>
          <div>
            <p class="year">Established {detail.year}</p>
            <h2>{event.name}</h2>
            {detail.latin && <p class="latin">{detail.latin}</p>}
            <p>{detail.line}</p>
          </div>
          <p class="status"><span>Commemorative edition</span><b>Under consideration</b></p>
        </article>
      );
    })}
  </section>
</BaseLayout>

<style>
  .calendar-hero { text-align: center; padding: clamp(4.5rem, 7vw, 7.5rem) 1.5rem; background: var(--ivory); border-bottom: 4px double var(--gold); }
  .calendar-hero .script { font-size: 2rem; margin: 0; }
  .calendar-hero h1 { font-size: clamp(4rem, 9vw, 8rem); line-height: .92; margin: 1rem 0 2rem; font-weight: 400; }
  .calendar-hero > p:last-child { font-size: 1.2rem; }
  .calendar-preface { display: grid; grid-template-columns: .32fr .78fr 1fr; gap: clamp(1.5rem, 5vw, 6rem); align-items: start; padding: clamp(3rem, 5vw, 5rem) clamp(1.25rem, 7vw, 8rem); background: #e8deca; border-bottom: 1px solid var(--gold); }
  .calendar-preface h2 { margin: 0; font-size: clamp(2.7rem, 5vw, 5.2rem); line-height: .95; }
  .calendar-preface > p:last-child { margin: 0; max-width: 680px; font-size: 1.05rem; line-height: 1.7; }
  .calendar-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--gold); padding: 1px; }
  article { min-width: 0; min-height: 400px; display: flex; flex-direction: column; padding: clamp(1.5rem, 3vw, 2.75rem); background: var(--paper); }
  article.y2k { background: var(--navy); color: white; border: 0; }
  .card-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1.5rem; margin-bottom: 2.5rem; }
  time { display: flex; align-items: flex-end; gap: .7rem; }
  time span { font-size: 4.5rem; line-height: .78; color: var(--crimson); }
  .y2k time span { color: var(--gold-light); }
  time b { padding-bottom: .15rem; font: 700 .62rem var(--sans); text-transform: uppercase; letter-spacing: .14em; }
  .event-device { width: 64px; height: 72px; object-fit: contain; }
  .year { margin: 0; color: var(--crimson); font: 700 .65rem var(--sans); text-transform: uppercase; letter-spacing: .13em; }
  .y2k .year { color: var(--gold-light); }
  article h2 { font-size: clamp(2rem, 3vw, 3.3rem); line-height: 1; margin: .5rem 0; font-weight: 400; }
  article div > p:last-child { max-width: 660px; line-height: 1.6; }
  .status { display: flex; justify-content: space-between; gap: 1rem; margin: auto 0 0; padding-top: 1.5rem; border-top: 1px solid var(--line); font: .58rem/1.4 var(--sans); text-transform: uppercase; letter-spacing: .1em; }
  .status span, .status b { display: block; }
  .status b { color: var(--crimson); }
  .y2k .status b { color: var(--gold-light); }
  @media (max-width: 980px) { .calendar-preface { grid-template-columns: 1fr 1fr; } .calendar-preface > p:last-child { grid-column: 2; } .calendar-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .calendar-preface { grid-template-columns: 1fr; } .calendar-preface > p:last-child { grid-column: auto; } .calendar-list { grid-template-columns: 1fr; } article { min-height: 0; } .card-header { margin-bottom: 1.5rem; } .status { margin-top: 2rem; } }
</style>
