---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Proclamation Not Found | Low Value Content" description="The requested proclamation could not be found.">
  <section class="missing"><p class="script">The Palace Regrets to Announce</p><h1>Proclamation not found.</h1><p>The requested content may have been removed, interrupted, monetized, or shown to someone else by the algorithm.</p><a class="button" href="/">Return to the realm</a></section>
</BaseLayout>
<style>.missing{min-height:72vh;padding:clamp(5rem,10vw,10rem) clamp(1.25rem,9vw,10rem);background:var(--paper)}.script{font-size:2rem}h1{font-size:clamp(4rem,9vw,9rem);line-height:.86;font-weight:400;margin:1rem 0 2rem}.missing>p:not(.script){max-width:700px;font-size:1.2rem;line-height:1.7;margin-bottom:2rem}</style>
