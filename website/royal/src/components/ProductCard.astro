---
import type { Product } from "../data";
import { hasRealmProvenance, productHref, productImage } from "../data";

const { product } = Astro.props as { product: Product };
const image = productImage(product);
const reignLabel = product.reign.replaceAll("-", " ");
const realmConnected = hasRealmProvenance(product);
---
<article class:list={["product-card", !image && "product-card-text"]}>
  <a class:list={["product-image", `art-${product.id}`]} href={productHref(product)}>
    {image ? <img src={image} alt={`Exact front artwork for ${product.primaryCopy}`} /> : (
      <div class="text-art">
        <span>{product.latin}</span>
        <strong>{product.primaryCopy}</strong>
        <i>{product.royalTreatment}</i>
      </div>
    )}
    <span class="product-number">No. {String(product.position).padStart(2, "0")}</span>
    <span class="art-label">What prints</span>
  </a>
  <div class="product-copy">
    <div class="classification"><p>{product.launchCollection}</p><span class={`intensity intensity-${product.realmIntensity}`}>{product.realmIntensity === "none" ? "Independent" : `${product.realmIntensity} realm`}</span></div>
    <h3><a href={productHref(product)}>{product.primaryCopy}</a></h3>
    <p class="issue">{realmConnected ? product.royalTreatment : product.originalCollection}</p>
    <p class="office">{realmConnected ? `${product.house} · ${reignLabel}` : "No House required · front-only editorial issue"}</p>
    <div class="status-row"><span>$32 planned</span><span>{product.commerceStatus === "test-sellable" ? "Test checkout" : "In development"}</span></div>
  </div>
</article>

<style>
  .product-card { display: flex; flex-direction: column; border-top: 1px solid var(--line); padding-top: 1rem; }
  .product-copy { flex: 1; display: flex; flex-direction: column; }
  .product-image { display: block; position: relative; background: #e9e0cf; overflow: hidden; aspect-ratio: 4 / 5; border: 1px solid rgba(23,32,42,.12); }
  .product-image img { width: 100%; height: 100%; padding: 7%; object-fit: contain; transition: transform .5s ease; }
  .product-image:hover img { transform: scale(1.025); }
  .product-number { position: absolute; left: .8rem; top: .8rem; background: var(--navy); color: var(--gold-light); padding: .45rem .6rem; font: .65rem/1 var(--sans); letter-spacing: .12em; }
  .art-label { position: absolute; right: .8rem; bottom: .8rem; padding: .42rem .55rem; background: rgba(244,238,223,.92); color: var(--navy); font: 700 .54rem/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; }
  .art-doomscrolling, .art-y2k-the-almost { background: #7d2734; }
  .art-much-published { background: #10263a; }
  .art-order-blue-check { background: #151515; }
  .art-saint-moth { background: #f1e8d2; }
  .classification { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin: 1rem 0 .5rem; }
  .classification p { margin: 0; text-transform: uppercase; letter-spacing: .13em; color: var(--crimson); font: 700 .65rem/1.3 var(--sans); }
  .intensity { flex: 0 0 auto; padding: .35rem .45rem; border: 1px solid var(--line); color: #565e68; font: 700 .54rem/1 var(--sans); letter-spacing: .1em; text-transform: uppercase; }
  .intensity-full { border-color: var(--gold); color: var(--navy); background: rgba(218,191,131,.18); }
  h3 { margin: 0; font-size: 1.35rem; line-height: 1.2; font-weight: 400; }
  h3 a { text-decoration: none; }
  .product-copy .issue { margin: .65rem 0 0; color: var(--navy); font: italic 1rem/1.35 var(--serif); }
  .product-copy .office { margin: .65rem 0 0; color: #565e68; font: .62rem/1.45 var(--sans); letter-spacing: .08em; text-transform: uppercase; }
  .product-copy > .status-row { display: flex; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: 1rem; font: .72rem/1.3 var(--sans); color: #565e68; }
  .product-copy .office { margin-bottom: .8rem; }
  .text-art { height: 100%; padding: 2rem; display: flex; flex-direction: column; justify-content: center; text-align: center; border: 12px double var(--navy); background: var(--ivory); }
  .text-art span { color: var(--gold); text-transform: uppercase; letter-spacing: .15em; font-size: .62rem; }
  .text-art strong { margin: 1.5rem 0; color: var(--navy); font-size: clamp(1.5rem, 3vw, 2.5rem); font-weight: 400; line-height: 1.05; text-transform: uppercase; }
  .text-art i { font-family: var(--script); color: var(--crimson); font-size: 1.2rem; }
</style>
