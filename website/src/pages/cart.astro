---
import BaseLayout from "../layouts/BaseLayout.astro";
import { isPurchasable, productHref, productImage, productMockup, products, variantOptions } from "../data";

// Display data only. The server re-prices every line from its own catalog at checkout.
const sellable = products.filter(isPurchasable);
const catalog = Object.fromEntries(
  sellable.map((product) => [
    product.commerce.catalogKey,
    {
      name: product.primaryCopy,
      price: product.commerce.priceCents,
      href: productHref(product),
      image: productMockup(product) ?? productImage(product),
      variants: Object.fromEntries(variantOptions(product).map((o) => [o.key, o.label])),
    },
  ]),
);
// Mirrors SHIPPING_AMOUNT in functions/src/catalog.ts, which is what Stripe actually charges.
const SHIPPING_CENTS = 599;
const suggestions = [...sellable].sort((a, b) => a.position - b.position);
---
<BaseLayout title="The Royal Purse | The Royal House of Engagement" description="Review your Low Value Content order before secure checkout." current="cart">
  <section class="cart-page" data-cart-root data-shipping-cents={SHIPPING_CENTS}>
    <header class="cart-head">
      <p class="eyebrow">Secure checkout</p>
      <h1>The Royal Purse</h1>
    </header>

    <div class="cart-empty" data-cart-empty hidden>
      <img src="/assets/royal-mark.svg" alt="" width="72" height="72" />
      <h2>The purse is empty</h2>
      <p>Six shirts, each printed to order. Choose a size and it will wait for you here.</p>
      <a class="button" href="/shop.html">Shop the six</a>
      <ul class="cart-suggest" aria-label="The six issues">
        {suggestions.map((product) => (
          <li>
            <a href={productHref(product)}>
              <img src={productMockup(product) ?? productImage(product)} alt="" loading="lazy" />
              <span class="suggest-name">{product.primaryCopy}</span>
              <span class="suggest-price">{`$${Math.round(product.commerce.priceCents / 100)}`}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="cart-layout" data-cart-filled hidden>
      <ul class="cart-lines" data-cart-lines aria-label="Items in your cart"></ul>
      <aside class="cart-summary" data-cart-summary aria-label="Order summary">
        <h2>The reckoning</h2>
        <dl>
          <div><dt data-cart-count-label>Subtotal</dt><dd data-cart-subtotal></dd></div>
          <div><dt>US shipping</dt><dd data-cart-shipping></dd></div>
          <div><dt>Tax</dt><dd class="muted">Calculated at checkout</dd></div>
          <div class="total"><dt>Estimated total</dt><dd data-cart-total></dd></div>
        </dl>
        <button class="button" type="button" data-cart-checkout>Checkout securely</button>
        <p class="buy-note" role="status" aria-live="polite"></p>
        <ul class="cart-assure">
          <li>Payment is handled by Stripe. We never see your card.</li>
          <li>Made to order and shipped to US addresses.</li>
          <li>Fit returns accepted within 30 days. <a href="/returns.html">Returns policy</a></li>
        </ul>
      </aside>
    </div>
  </section>
  <script id="cart-catalog" type="application/json" set:html={JSON.stringify(catalog)} />
</BaseLayout>
