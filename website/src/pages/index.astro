---
import BaseLayout from "../layouts/BaseLayout.astro";
import { blankClass, houses, productHref, productImageSmall, products } from "../data";

const price = (product: (typeof products)[number]) => `$${Math.round(product.commerce.priceCents / 100)}`;
const facts = [
  ["Heavyweight and soft.", "Garment-dyed, pre-shrunk cotton: Comfort Colors 1717, 6.1 oz."],
  ["One print, on the front.", "No back print and no logo on the sleeve. The shirt says one thing."],
  ["Made after you order.", "Each shirt is printed to order, so none wait in a warehouse."],
  ["Shipped in the United States.", "United States orders only for now."],
];
---
<BaseLayout title="Shirts for the chronically online | The Royal House of Engagement" description="Six satirical T-shirts about feeds, followers and the person who keeps refreshing them. Garment-dyed cotton, one front print each, made to order by Low Value Content." current="home">
  <section class="hero">
    <h1>Shirts for the<br />chronically online.</h1>
    <div class="hero-sub">
      <p>Six issues, each with one dry observation printed on the front. Made to order on soft, garment-dyed cotton by Low Value Content, for the Royal House of Engagement.</p>
      <div class="hero-actions"><a class="button" href="/shop.html">Shop the six</a><a class="text-link" href="/realm.html">Read about the Royal House</a></div>
    </div>
    <ol class="wall" aria-label="The six issues">
      {products.map((product) => (
        <li class:list={["tile", blankClass(product)]}>
          <a href={productHref(product)}>
            <img src={productImageSmall(product)} alt={`Front print: ${product.primaryCopy}`} width="800" height="960" loading={product.position <= 3 ? "eager" : "lazy"} />
            <span class="tile-no">No. {String(product.position).padStart(2, "0")}</span>
            <span class="tile-price">{price(product)}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="facts" aria-labelledby="facts-heading">
    <h2 id="facts-heading">What you are buying</h2>
    <dl>
      {facts.map(([lead, rest]) => <div><dt>{lead}</dt><dd>{rest}</dd></div>)}
    </dl>
  </section>

  <section class="realm">
    <div class="realm-copy">
      <h2>Every shirt is an official issue of a kingdom that does not exist.</h2>
      <p>The Royal House of Engagement governs the attention economy through six Great Houses, a line of sovereigns and a calendar of feasts. It takes all of this very seriously, and the shirts are how it issues its notices.</p>
      <a class="button light" href="/realm.html">Enter the Realm</a>
    </div>
    <img class="arms" src="/assets/royal-arms.svg" alt="The arms of the Royal House of Engagement: a notification shield beneath a Wi-Fi crown" width="320" height="380" />
    <ul class="houses" aria-label="The six Great Houses">
      {houses.map((house) => <li><a href="/realm.html#great-houses"><img src={`/assets/house-${house.id}.svg`} alt="" width="44" height="44" loading="lazy" /><span>{house.name}</span></a></li>)}
    </ul>
  </section>

  <section class="close">
    <h2>Six shirts. Printed when you order.</h2>
    <a class="button" href="/shop.html">Shop the six</a>
  </section>
</BaseLayout>

<style>
  .hero { padding: clamp(2.5rem, 6vw, 5rem) var(--gutter) clamp(3rem, 6vw, 5rem); }
  .hero h1 { margin: 0; font: 800 clamp(3.1rem, 8.6vw, 6.9rem)/.9 var(--display); text-transform: uppercase; letter-spacing: -.005em; color: var(--navy); text-wrap: balance; }
  .hero-sub { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 1.5rem 3rem; align-items: end; margin: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(2rem, 4vw, 3.5rem); }
  .hero-sub p { margin: 0; max-width: 40rem; font-size: 1.1rem; line-height: 1.75; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; }
  .hero-actions .button { padding: 1.05rem 1.7rem; font-size: .8rem; }
  .wall { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(.5rem, 1.2vw, 1rem); }
  .tile { position: relative; aspect-ratio: 5 / 6; overflow: hidden; }
  .tile a { display: block; height: 100%; }
  .tile img { width: 100%; height: 100%; object-fit: contain; padding: 5%; transition: transform .35s ease; }
  .tile a:hover img, .tile a:focus-visible img { transform: scale(1.03); }
  .tile-no, .tile-price { position: absolute; bottom: .75rem; font: 800 1.05rem/1 var(--display); letter-spacing: .06em; text-transform: uppercase; color: #fff; background: rgba(13, 28, 43, .82); padding: .4rem .6rem; }
  .tile-no { left: .75rem; }
  .tile-price { right: .75rem; }
  .facts { margin: 0 var(--gutter); padding: clamp(3rem, 6vw, 5.5rem) 0; border-top: 1px solid var(--navy); }
  .facts h2 { margin: 0 0 1.75rem; font: 800 clamp(2rem, 4vw, 3rem)/1 var(--display); text-transform: uppercase; color: var(--navy); }
  .facts dl { margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2rem; }
  .facts dt { font-weight: 700; line-height: 1.35; }
  .facts dd { margin: .5rem 0 0; line-height: 1.65; font-size: .95rem; color: #3b4651; }
  .realm { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 2rem clamp(2rem, 5vw, 5rem); align-items: center; background: var(--navy); color: var(--ivory); padding: clamp(3rem, 6vw, 5.5rem) var(--gutter); }
  .realm h2 { margin: 0 0 1.25rem; font: 800 clamp(2.4rem, 5vw, 4.2rem)/.98 var(--display); text-transform: uppercase; }
  .realm p { margin: 0 0 1.75rem; max-width: 38rem; line-height: 1.75; color: rgba(244, 238, 223, .85); }
  .arms { width: min(100%, 320px); height: auto; justify-self: center; }
  .houses { grid-column: 1 / -1; list-style: none; margin: 1rem 0 0; padding: 1.75rem 0 0; border-top: 1px solid rgba(218, 191, 131, .35); display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 1rem; }
  .houses a { display: flex; align-items: center; gap: .75rem; text-decoration: none; font-size: .85rem; line-height: 1.3; }
  .houses a:hover span, .houses a:focus-visible span { text-decoration: underline; text-underline-offset: 4px; }
  .houses img { flex: none; background: var(--ivory); border-radius: 50%; padding: 3px; }
  .close { padding: clamp(3.5rem, 7vw, 6rem) var(--gutter); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem 3rem; }
  .close h2 { margin: 0; font: 800 clamp(2.2rem, 5vw, 4rem)/.98 var(--display); text-transform: uppercase; color: var(--navy); }
  @media (max-width: 900px) {
    .hero-sub { grid-template-columns: minmax(0, 1fr); }
    .facts dl { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .realm { grid-template-columns: minmax(0, 1fr); }
    .arms { justify-self: start; width: 200px; }
    .houses { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .wall { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .facts dl { grid-template-columns: minmax(0, 1fr); }
    .houses { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tile-no, .tile-price { font-size: .9rem; bottom: .5rem; }
  }
</style>
