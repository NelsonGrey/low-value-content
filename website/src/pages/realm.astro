---
import BaseLayout from "../layouts/BaseLayout.astro";
import RealmNav from "../components/RealmNav.astro";
import { constitution, products, productHref } from "../data";

const realmProductIds = new Set(["thought-leader", "doomscrolling", "much-published", "order-blue-check", "y2k-the-almost", "saint-moth"]);
const realmProducts = products.filter((product) => realmProductIds.has(product.id));
const stateTerms = [
  ["Natural resource", constitution.naturalResource],
  ["Political legitimacy", constitution.crown],
  ["Currency", constitution.currency],
  ["Aristocracy", constitution.aristocracy],
  ["Principal industry", constitution.industry],
  ["Divine providence", constitution.providence],
];
const rooms = [
  ["/realm/constitution.html", "The Constitution", "The seven ranks of authority, the doctrine of convenient evidence and the current constitutional crisis."],
  ["/realm/houses.html", "The Great Houses", "Six permanent branches of government, each with a portfolio, an office and a contradiction, and the Royal Standard that carries their charges."],
  ["/realm/peerage.html", "Peerage and Orders", "Titles that describe the distinction, Houses that explain the damage, and the register that keeps score."],
] as const;
---
<BaseLayout title="The Realm of Engagement | The Royal House of Engagement" description="The constitution, Great Houses, peerage, institutions, and official contradictions of the Royal House of Engagement." current="realm">
  <header class="realm-hero">
    <div>
      <p class="script">By Sovereign Instrument</p>
      <h1>The government<br />of attention.</h1>
      <p>{constitution.premise}</p>
    </div>
    <div class="realm-arms">
      <img src="/assets/royal-shield.svg" alt="Shield of the Royal House of Engagement: a loading ring, a card, a liked heart and a cursor under a Wi-Fi crown" />
      <p>The Most Ancient and Most Serene<br /><b>Royal House of Engagement</b></p>
      <span>Multa edita, pauca dicta</span>
    </div>
  </header>
  <RealmNav current="overview" />

  <section class="state-ledger section">
    <div class="section-heading">
      <p class="eyebrow">The state at a glance</p>
      <h2>A complete economy.<br /><span class="script">Properly constituted.</span></h2>
      <p>The terms are not interchangeable. Each describes a different part of the machinery that turns human attention into institutional self-importance.</p>
    </div>
    <dl>{stateTerms.map(([term, value]) => <div><dt>{term}</dt><dd>{value}</dd></div>)}</dl>
    <aside><p class="eyebrow">Known outside the court as</p><strong>{constitution.unofficialConsequence}</strong><span>Official designation: {constitution.officialConsequence}</span></aside>
  </section>

  <section class="rooms section" aria-labelledby="rooms-heading">
    <div class="section-heading">
      <p class="eyebrow">Explore the Realm</p>
      <h2 id="rooms-heading">Three rooms.<br /><span class="script">One government.</span></h2>
    </div>
    <ul>
      {rooms.map(([href, title, blurb]) => <li><a href={href}><h3>{title}</h3><p>{blurb}</p><span>Enter</span></a></li>)}
    </ul>
  </section>

  <section class="wardrobe section">
    <div class="section-heading"><p class="eyebrow">The Realm made wearable</p><h2>The official issues</h2><p>These garments naturally belong to the Crown, a Great House, an Order, or the commemorative record. Public Notices remain independent beyond the palace walls.</p></div>
    <div class="issue-list">{realmProducts.map((product) => <a href={productHref(product)}><span>No. {String(product.position).padStart(2, "0")}</span><div><p>{product.house}</p><h3>{product.primaryCopy}</h3><small>{product.realmIssue.wearerTitle}</small></div><b>View issue →</b></a>)}</div>
  </section>
</BaseLayout>

<style>
  .realm-hero { display: grid; grid-template-columns: 1.1fr .9fr; min-height: min(620px, 80vh); background: var(--navy); color: white; }
  .realm-hero > div { min-width: 0; padding: clamp(3.5rem, 6vw, 6rem) clamp(2rem, 4vw, 4rem) clamp(3.5rem, 6vw, 6rem) var(--gutter); align-self: center; }
  .realm-hero .script { color: var(--gold-light); font-size: 2rem; }
  .realm-hero h1 { font-size: var(--fs-h1); line-height: .96; letter-spacing: -.03em; font-weight: 400; margin: 1rem 0 1.75rem; }
  .realm-hero p:last-child { max-width: 680px; font-size: 1.15rem; line-height: 1.7; }
  .realm-hero > .realm-arms { align-self: stretch; padding: 2rem var(--gutter) 2rem 2rem; }
  .realm-arms { display: grid; place-items: center; align-content: center; text-align: center; background: radial-gradient(circle at center, var(--navy-2), #08131e 72%); border-left: 1px solid var(--line); }
  .realm-arms img { width: min(500px, 88%); max-height: 470px; }
  .realm-arms p { color: var(--gold-light); text-transform: uppercase; letter-spacing: .18em; font: .68rem/1.8 var(--sans); }
  .realm-arms p b { color: var(--ivory); font-size: .95rem; }
  .realm-arms span { color: rgba(244,238,223,.55); font: .62rem var(--sans); letter-spacing: .18em; text-transform: uppercase; }
  .state-ledger { background: #e8deca; border-top: 4px double var(--gold); }
  .state-ledger dl { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .state-ledger dl div { padding: 2rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .state-ledger dt { color: var(--crimson); font: 700 .65rem var(--sans); letter-spacing: .14em; text-transform: uppercase; }
  .state-ledger dd { margin: 1rem 0 0; font-size: 2rem; }
  .state-ledger aside { margin-top: 3rem; padding: 2.5rem; background: var(--navy); color: white; display: grid; grid-template-columns: 1fr auto; gap: .5rem 2rem; align-items: center; }
  .state-ledger aside p { margin: 0; color: var(--gold-light); }
  .state-ledger aside strong { grid-row: 1 / 3; grid-column: 2; font-size: clamp(2.5rem, 6vw, 6rem); font-weight: 400; }
  .state-ledger aside span { color: rgba(255,255,255,.65); }
  .wardrobe { background: #e8deca; }
  .issue-list { border-top: 1px solid var(--line); }
  .issue-list a { display: grid; grid-template-columns: 90px 1fr auto; gap: 2rem; align-items: center; padding: 1.4rem 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .issue-list > a > span, .issue-list > a > b { color: var(--crimson); font: 700 .65rem/1.3 var(--sans); letter-spacing: .12em; text-transform: uppercase; }
  .issue-list p { margin: 0 0 .25rem; color: #565e68; font: .62rem/1.3 var(--sans); letter-spacing: .1em; text-transform: uppercase; }
  .issue-list h3 { margin: 0; font-size: 1.5rem; font-weight: 400; }
  .issue-list small { display: block; margin-top: .3rem; color: #565e68; font-style: italic; }
  .rooms { background: var(--paper); }
  .rooms ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .rooms li { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .rooms li:last-child { border-right: 0; }
  .rooms a { display: grid; gap: .75rem; align-content: start; height: 100%; padding: 2rem; text-decoration: none; }
  .rooms a:hover, .rooms a:focus-visible { background: #f3ecdc; }
  .rooms h3 { margin: 0; font: 800 clamp(1.8rem, 3vw, 2.4rem)/1 var(--display); text-transform: uppercase; color: var(--navy); }
  .rooms p { margin: 0; line-height: 1.65; color: #3b4651; }
  .rooms a span { margin-top: .5rem; color: var(--crimson); font: 700 .72rem var(--sans); letter-spacing: .12em; text-transform: uppercase; }
  @media (max-width: 900px) { .realm-hero { grid-template-columns: minmax(0, 1fr); } .realm-hero > div { padding-inline: var(--gutter); } .state-ledger dl { grid-template-columns: repeat(2, minmax(0, 1fr)); } .state-ledger aside { grid-template-columns: 1fr; } .state-ledger aside strong { grid-row: auto; grid-column: auto; } .rooms ul { grid-template-columns: minmax(0, 1fr); } .rooms li { border-right: 0; } }
  @media (max-width: 560px) { .state-ledger dl { grid-template-columns: 1fr; } .issue-list a { grid-template-columns: 60px 1fr; gap: 1rem; } .issue-list > a > b { display: none; } }
</style>
