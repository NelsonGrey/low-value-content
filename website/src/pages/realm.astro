---
import BaseLayout from "../layouts/BaseLayout.astro";
import { constitution, houses, orders, peerage, products, productHref } from "../data";

const realmProductIds = new Set(["thought-leader", "doomscrolling", "much-published", "order-blue-check", "y2k-the-almost", "saint-moth"]);
const realmProducts = products.filter((product) => realmProductIds.has(product.id));
const stateTerms = [
  ["Natural resource", constitution.naturalResource],
  ["Political legitimacy", constitution.crown],
  ["Currency", constitution.currency],
  ["Aristocracy", constitution.aristocracy],
  ["Principal industry", constitution.industry],
  ["Divine providence", constitution.providence],
];
---
<BaseLayout title="The Realm of Engagement | The Royal House of Engagement" description="The constitution, Great Houses, peerage, institutions, and official contradictions of the Royal House of Engagement." current="realm">
  <header class="realm-hero">
    <div>
      <p class="script">By Sovereign Instrument</p>
      <h1>The government<br />of attention.</h1>
      <p>{constitution.premise}</p>
    </div>
    <div class="realm-arms">
      <img src="/assets/royal-arms.svg" alt="Arms of the Royal House of Engagement" />
      <p>The Most Ancient and Most Serene<br /><b>Royal House of Engagement</b></p>
      <span>Multa edita, pauca dicta</span>
    </div>
  </header>

  <section class="state-ledger section">
    <div class="section-heading">
      <p class="eyebrow">The state at a glance</p>
      <h2>A complete economy.<br /><span class="script">Properly constituted.</span></h2>
      <p>The terms are not interchangeable. Each describes a different part of the machinery that turns human attention into institutional self-importance.</p>
    </div>
    <dl>{stateTerms.map(([term, value]) => <div><dt>{term}</dt><dd>{value}</dd></div>)}</dl>
    <aside><p class="eyebrow">Known outside the court as</p><strong>{constitution.unofficialConsequence}</strong><span>Official designation: {constitution.officialConsequence}</span></aside>
  </section>

  <section class="hierarchy section">
    <div class="section-heading">
      <p class="eyebrow">The constitutional hierarchy</p>
      <h2>Authority descends.<br /><span class="script">Responsibility does not.</span></h2>
    </div>
    <ol>{constitution.hierarchy.map((level) => <li><span>{String(level.rank).padStart(2, "0")}</span><div><h3>{level.name}</h3><p>{level.function}</p></div></li>)}</ol>
  </section>

  <section class="houses section" id="great-houses">
    <div class="section-heading">
      <p class="eyebrow">Court precedence under Prompt I</p>
      <h2>The Six Great Houses</h2>
      <p>The Houses are constitutionally equal. Their precedence changes with each reign and whenever the dashboard needs to tell a better story.</p>
    </div>
    <div class="house-grid">
      {houses.map((house) => (
        <article>
          <div class="house-rank"><span>{String(house.precedence).padStart(2, "0")}</span><img src={`/assets/house-${house.id}.svg`} alt={`Badge of the ${house.name}`} /></div>
          <p class="standing">{house.standing}</p>
          <h3>{house.name}</h3>
          <p class="portfolio">{house.portfolio}</p>
          <blockquote>{house.contradiction}</blockquote>
          <p class="institution">{house.institution}</p>
          <p class="latin">{house.latin} · {house.line}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="royal-standard">
    <div><p class="eyebrow">The sovereign field</p><h2>One standard.<br /><span class="script">Six jurisdictions.</span></h2><p>The central check records legitimacy by verified appearance. The six charges identify the portfolios through which attention is produced, retained, declared important, measured, distributed, and indefinitely delayed.</p></div>
    <figure><img src="/assets/royal-standard.svg" alt="The Royal Standard of Engagement bearing the six House charges" /><figcaption>The Royal Standard · current issue under Prompt I</figcaption></figure>
  </section>

  <section class="doctrine">
    <div><p class="script">The doctrine of convenient evidence</p><h2>All decisions shall be data&#8209;driven.</h2><p>All data shall be interpreted in accordance with the decision.</p></div>
    <ol>{constitution.principles.map((principle, index) => <li><span>{String(index + 1).padStart(2, "0")}</span>{principle}</li>)}</ol>
  </section>

  <section class="peerage section">
    <div class="section-heading">
      <p class="eyebrow">The peerage</p>
      <h2>A title describes the distinction.<br /><span class="script">A House explains the damage.</span></h2>
      <p>Institutions provide respectable justification. Orders recognize conspicuous achievement across House boundaries.</p>
    </div>
    <div class="peerage-grid">
      <ol>{peerage.map((rank) => <li><span>{String(rank.rank).padStart(2, "0")}</span><div><h3>{rank.title}</h3><p>{rank.rule}</p><small>{rank.example} · {rank.house}</small></div></li>)}</ol>
      <article class="duke-card">
        <p class="eyebrow">Worked example</p>
        <h3>His Grace,<br />the Duke of Doomscrolling</h3>
        <p>First Peer of the House of Scroll<br />Fellow of the Royal Institute of Digital Inquiry<br />Companion of the Order of the Blue Check</p>
        <span>The full style is preserved in the official record. The garment bears the designation appropriate to its station.</span>
      </article>
    </div>
    <div class="orders">{orders.map((order, index) => <article><img src={index === 0 ? "/assets/order-blue-check.svg" : "/assets/order-jacquard.svg"} alt={`Insignia of the ${order.name}`} /><div><p>{order.rank}</p><h3>{order.name}</h3><span>{order.rule}</span></div></article>)}</div>
  </section>

  <section class="universal-peerage">
    <p class="eyebrow">Current constitutional crisis</p>
    <h2>The Universal Peerage</h2>
    <blockquote>Once every subject had acquired influence, the Crown discovered that no uninfluenced population remained.</blockquote>
    <p>The matter was referred to committee.</p>
  </section>

  <section class="wardrobe section">
    <div class="section-heading"><p class="eyebrow">The Realm made wearable</p><h2>The official issues</h2><p>These garments naturally belong to the Crown, a Great House, an Order, or the commemorative record. Public Notices remain independent beyond the palace walls.</p></div>
    <div class="issue-list">{realmProducts.map((product) => <a href={productHref(product)}><span>No. {String(product.position).padStart(2, "0")}</span><div><p>{product.house}</p><h3>{product.primaryCopy}</h3><small>{product.realmIssue.wearerTitle}</small></div><b>View issue →</b></a>)}</div>
  </section>

  <section class="section qr">
    <div class="qr-mark" aria-hidden="true"><span>▦</span></div>
    <div><p class="eyebrow">The permanent record</p><h2>Scan the seal.<br /><span class="script">Consult the register.</span></h2><p>Every design has a permanent owned-domain route, while the launch garment remains front-only. Provenance, titles, House affiliation, and constitutional records are maintained online and in official packaging.</p><ol><li>Scan the issue card</li><li>Consult its provenance</li><li>Confirm rank and standing</li><li>Present the official record</li></ol></div>
  </section>
</BaseLayout>

<style>
  .realm-hero { display: grid; grid-template-columns: 1.1fr .9fr; min-height: min(620px, 80vh); background: var(--navy); color: white; }
  .realm-hero > div { min-width: 0; padding: clamp(3.5rem, 6vw, 6rem) clamp(2rem, 4vw, 4rem) clamp(3.5rem, 6vw, 6rem) var(--gutter); align-self: center; }
  .realm-hero .script { color: var(--gold-light); font-size: 2rem; }
  .realm-hero h1 { font-size: var(--fs-h1); line-height: .96; letter-spacing: -.03em; font-weight: 400; margin: 1rem 0 1.75rem; }
  .realm-hero p:last-child { max-width: 680px; font-size: 1.15rem; line-height: 1.7; }
  .realm-hero > .realm-arms { align-self: stretch; padding: 2rem var(--gutter) 2rem 2rem; }
  .realm-arms { display: grid; place-items: center; align-content: center; text-align: center; background: radial-gradient(circle at center, var(--navy-2), #08131e 72%); border-left: 1px solid var(--line); }
  .realm-arms img { width: min(500px, 88%); max-height: 470px; }
  .realm-arms p { color: var(--gold-light); text-transform: uppercase; letter-spacing: .18em; font: .68rem/1.8 var(--sans); }
  .realm-arms p b { color: var(--ivory); font-size: .95rem; }
  .realm-arms span { color: rgba(244,238,223,.55); font: .62rem var(--sans); letter-spacing: .18em; text-transform: uppercase; }
  .state-ledger { background: #e8deca; border-top: 4px double var(--gold); }
  .state-ledger dl { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .state-ledger dl div { padding: 2rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .state-ledger dt { color: var(--crimson); font: 700 .65rem var(--sans); letter-spacing: .14em; text-transform: uppercase; }
  .state-ledger dd { margin: 1rem 0 0; font-size: 2rem; }
  .state-ledger aside { margin-top: 3rem; padding: 2.5rem; background: var(--navy); color: white; display: grid; grid-template-columns: 1fr auto; gap: .5rem 2rem; align-items: center; }
  .state-ledger aside p { margin: 0; color: var(--gold-light); }
  .state-ledger aside strong { grid-row: 1 / 3; grid-column: 2; font-size: clamp(2.5rem, 6vw, 6rem); font-weight: 400; }
  .state-ledger aside span { color: rgba(255,255,255,.65); }
  .hierarchy { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; background: var(--paper); }
  .hierarchy .section-heading { display: block; position: sticky; top: 130px; margin: 0; }
  .hierarchy .section-heading h2 { font-size: var(--fs-h2); }
  .hierarchy .section-heading .eyebrow { margin-bottom: .5rem; }
  .hierarchy ol { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
  .hierarchy li:nth-child(1) { --i: 0; } .hierarchy li:nth-child(2) { --i: 1; } .hierarchy li:nth-child(3) { --i: 2; } .hierarchy li:nth-child(4) { --i: 3; } .hierarchy li:nth-child(5) { --i: 4; } .hierarchy li:nth-child(6) { --i: 5; } .hierarchy li:nth-child(7) { --i: 6; }
  .hierarchy li { display: grid; grid-template-columns: 3.5rem 1fr; gap: 1rem; padding: 1.4rem 0 1.4rem calc(var(--i) * clamp(.5rem, 1.6vw, 1.75rem)); border-bottom: 1px solid var(--line); }
  .hierarchy li:first-child h3 { color: var(--crimson); }
  .hierarchy li > span { color: var(--crimson); font: 700 .7rem var(--sans); letter-spacing: .14em; }
  .hierarchy h3, .hierarchy p { margin: 0; }
  .hierarchy h3 { font-size: 1.6rem; font-weight: 400; }
  .hierarchy p { margin-top: .35rem; color: #565e68; line-height: 1.55; }
  .houses { background: #eee5d4; }
  .house-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .house-grid article { min-height: 360px; padding: 1.75rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .house-rank { display: flex; align-items: flex-start; justify-content: space-between; min-height: 62px; }
  .house-rank span, .standing, .institution { font: 700 .62rem/1.4 var(--sans); letter-spacing: .13em; text-transform: uppercase; }
  .house-rank span, .standing { color: var(--crimson); }
  .house-rank img { width: 54px; margin: -.35rem -.25rem 0 0; }
  .standing { margin: .85rem 0 .4rem; }
  .house-grid h3 { margin: 0; font-size: 2rem; font-weight: 400; }
  .portfolio { min-height: 44px; color: #565e68; line-height: 1.5; }
  .house-grid blockquote { margin: 1.35rem 0; font-size: 1.16rem; line-height: 1.35; }
  .institution { color: var(--navy); }
  .house-grid .latin { line-height: 1.7; }
  .royal-standard { display: grid; grid-template-columns: minmax(280px, 1fr) minmax(320px, 480px); gap: clamp(2rem, 6vw, 6rem); align-items: center; padding: clamp(3rem, 5vw, 5rem) var(--gutter); background: var(--navy); color: var(--ivory); border-top: 4px double var(--gold); border-bottom: 4px double var(--gold); }
  .royal-standard .eyebrow, .royal-standard h2 .script { color: var(--gold-light); }
  .royal-standard h2 { margin: .75rem 0 1.5rem; font-size: var(--fs-h2); line-height: 1; font-weight: 400; }
  .royal-standard p:not(.eyebrow) { color: rgba(244,238,223,.74); font-size: 1.08rem; line-height: 1.7; }
  .royal-standard figure { width: 100%; max-width: 480px; margin: 0 0 0 auto; padding: .6rem; border: 1px solid var(--gold); background: #091522; }
  .royal-standard img { width: 100%; }
  .royal-standard figcaption { padding-top: .8rem; color: var(--gold-light); font: .62rem var(--sans); letter-spacing: .14em; text-transform: uppercase; }
  .doctrine { display: grid; grid-template-columns: .85fr 1.15fr; background: var(--crimson); color: white; }
  .doctrine > div { padding: clamp(4rem, 7vw, 7rem); align-self: center; }
  .doctrine .script { color: var(--gold-light); font-size: 2rem; }
  .doctrine h2 { margin: 1rem 0; font-size: clamp(2.6rem, 4.6vw, 4.6rem); line-height: 1; font-weight: 400; }
  .doctrine > div > p:last-child { font-size: 1.25rem; line-height: 1.6; }
  .doctrine ol { list-style: none; padding: 0; margin: 0; }
  .doctrine li { min-height: 86px; padding: 1.5rem 2rem; display: grid; grid-template-columns: 55px 1fr; gap: 1rem; align-items: center; border-left: 1px solid rgba(255,255,255,.25); border-bottom: 1px solid rgba(255,255,255,.25); font-size: 1.05rem; }
  .doctrine li span { color: var(--gold-light); font: .62rem var(--sans); letter-spacing: .14em; }
  .peerage { background: var(--paper); }
  .peerage-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 3rem; }
  .peerage-grid > ol { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .peerage-grid > ol li { display: grid; grid-template-columns: 60px 1fr; gap: 1rem; padding: 1.25rem 0; border-bottom: 1px solid var(--line); }
  .peerage-grid li > span { color: var(--crimson); font: 700 .65rem var(--sans); }
  .peerage-grid h3, .peerage-grid p { margin: 0; }
  .peerage-grid h3 { font-size: 1.45rem; font-weight: 400; }
  .peerage-grid p { margin-top: .35rem; line-height: 1.5; }
  .peerage-grid small { display: block; margin-top: .5rem; color: #565e68; font-style: italic; }
  .duke-card { padding: 2.5rem; border: 8px double var(--gold); background: var(--ivory); }
  .duke-card h3 { margin: 1rem 0 2rem; font-size: clamp(2.2rem, 4vw, 4rem); line-height: 1; }
  .duke-card p:not(.eyebrow) { line-height: 1.8; }
  .duke-card span { display: block; margin-top: 2rem; color: #565e68; font-style: italic; line-height: 1.5; }
  .orders { display: grid; grid-template-columns: repeat(2, 1fr); margin-top: 3rem; }
  .orders article { display: grid; grid-template-columns: 62px 1fr; gap: 1rem; align-items: center; padding: 1.25rem; border: 1px solid var(--line); }
  .orders img { width: 58px; max-height: 72px; }
  .orders p { color: var(--crimson); font: 700 .62rem var(--sans); letter-spacing: .14em; text-transform: uppercase; }
  .orders h3 { font-size: 2rem; font-weight: 400; }
  .orders span { color: #565e68; line-height: 1.5; }
  .universal-peerage { padding: clamp(4.5rem, 7vw, 7rem) 1.5rem; text-align: center; background: var(--navy); color: white; border-top: 4px double var(--gold); }
  .universal-peerage .eyebrow { color: var(--gold-light); }
  .universal-peerage h2 { margin: 1rem 0; font-size: var(--fs-h1); line-height: 1; font-weight: 400; }
  .universal-peerage blockquote { max-width: 900px; margin: 2rem auto; color: var(--gold-light); font-size: clamp(1.8rem, 4vw, 3.5rem); line-height: 1.25; }
  .universal-peerage > p:last-child { font: .72rem var(--sans); letter-spacing: .14em; text-transform: uppercase; }
  .wardrobe { background: #e8deca; }
  .issue-list { border-top: 1px solid var(--line); }
  .issue-list a { display: grid; grid-template-columns: 90px 1fr auto; gap: 2rem; align-items: center; padding: 1.4rem 0; border-bottom: 1px solid var(--line); text-decoration: none; }
  .issue-list > a > span, .issue-list > a > b { color: var(--crimson); font: 700 .65rem/1.3 var(--sans); letter-spacing: .12em; text-transform: uppercase; }
  .issue-list p { margin: 0 0 .25rem; color: #565e68; font: .62rem/1.3 var(--sans); letter-spacing: .1em; text-transform: uppercase; }
  .issue-list h3 { margin: 0; font-size: 1.5rem; font-weight: 400; }
  .issue-list small { display: block; margin-top: .3rem; color: #565e68; font-style: italic; }
  .qr { display: grid; grid-template-columns: .7fr 1.3fr; gap: clamp(3rem, 8vw, 9rem); align-items: center; }
  .qr-mark { aspect-ratio: 1; display: grid; place-items: center; border: 14px double var(--navy); background: var(--ivory); }
  .qr-mark span { font-size: clamp(7rem, 20vw, 16rem); color: var(--navy); }
  .qr h2 { font-size: var(--fs-h2); line-height: 1; font-weight: 400; }
  .qr p:not(.eyebrow) { font-size: 1.1rem; line-height: 1.7; max-width: 700px; }
  .qr ol { padding: 1.5rem 0 0; list-style-position: inside; columns: 2; font-family: var(--sans); line-height: 2; }
  @media (max-width: 900px) { .hierarchy .section-heading { position: static; } .hierarchy, .realm-hero, .royal-standard, .doctrine, .peerage-grid, .qr { grid-template-columns: minmax(0, 1fr); } .realm-hero > div { padding-inline: var(--gutter); } .house-grid, .state-ledger dl { grid-template-columns: repeat(2, minmax(0, 1fr)); } .state-ledger aside { grid-template-columns: 1fr; } .state-ledger aside strong { grid-row: auto; grid-column: auto; } }
  @media (max-width: 560px) { .house-grid, .state-ledger dl, .orders { grid-template-columns: 1fr; } .qr ol { columns: 1; } .issue-list a { grid-template-columns: 60px 1fr; gap: 1rem; } .issue-list > a > b { display: none; } }
</style>
