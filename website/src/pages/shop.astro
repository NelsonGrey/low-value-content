---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import { products } from "../data";

const issues = [...products].sort((a, b) => a.position - b.position);
---
<BaseLayout title="The Regalia of Engagement | The Royal House of Engagement" description="The six founding issues of the Royal House of Engagement, by Low Value Content: official regalia for the attention economy." current="shop">
  <header class="shop-head">
    <p class="eyebrow">The founding collection</p>
    <h1>The regalia.</h1>
    <p>Six issues, each with one dry observation printed on the front. Made to order on garment-dyed Comfort Colors cotton. Some are issued by the Court; others circulate under public notice.</p>
  </header>
  <section class="shop-grid-wrap">
    <h2 class="sr-only">The six issues</h2>
    <div class="product-grid">{issues.map((product) => <ProductCard product={product} />)}</div>
  </section>
  <section class="regalia-note">
    <img src="/assets/royal-shield.svg" alt="Shield of the Royal House of Engagement" />
    <div><p class="eyebrow">A note from the wardrobe</p><h2>The House confers authority. It does not issue decoration.</h2><p>The peacock, parrot, notification shield, Wi-Fi crown, seals, standards, Latin, and calligraphy constitute the ceremonial library. Their use is reserved for garments possessing recognized standing before the court.</p><a class="text-link" href="/realm.html">Consult the constitution →</a></div>
  </section>
</BaseLayout>

<style>
  .shop-head { padding: clamp(2.5rem, 6vw, 5rem) var(--gutter) clamp(2rem, 4vw, 3rem); }
  .shop-head h1 { margin: .6rem 0 1.25rem; font: 800 clamp(3.1rem, 8.6vw, 6.9rem)/.9 var(--display); text-transform: uppercase; color: var(--navy); }
  .shop-head p:last-child { max-width: 44rem; margin: 0; font-size: 1.125rem; line-height: 1.7; color: #2c3640; }
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .shop-grid-wrap { padding: 0 var(--gutter) clamp(3.5rem, 7vw, 6rem); }
  .product-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3rem 1.5rem; }
  .regalia-note { display: grid; grid-template-columns: minmax(0, .6fr) minmax(0, 1.4fr); gap: clamp(2rem, 6vw, 6rem); align-items: center; padding: clamp(3rem, 6vw, 5.5rem) var(--gutter); background: var(--navy); color: var(--ivory); }
  .regalia-note img { width: min(260px, 70%); margin: auto; }
  .regalia-note .eyebrow { color: var(--gold-light); margin: 0; }
  .regalia-note h2 { margin: .75rem 0 1.25rem; font: 800 clamp(2.2rem, 4.6vw, 3.8rem)/.98 var(--display); text-transform: uppercase; }
  .regalia-note p:not(.eyebrow) { max-width: 40rem; margin: 0 0 1.5rem; color: rgba(244,238,223,.82); font-size: 1.05rem; line-height: 1.7; }
  .regalia-note .text-link { color: var(--gold-light); }
  @media (max-width: 1000px) { .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .regalia-note { grid-template-columns: 1fr; } .regalia-note img { margin: 0; width: 160px; } }
  @media (max-width: 560px) { .product-grid { grid-template-columns: 1fr; } }
</style>
