---
interface Props {
  title: string;
  description: string;
  current?: string;
}

const { title, description, current = "" } = Astro.props;
const nav = [
  ["realm", "/realm.html", "The Realm"],
  ["lineage", "/lineage.html", "The Lineage"],
  ["calendar", "/calendar.html", "Royal Calendar"],
  ["shop", "/shop.html", "The Regalia"],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1c2b" />
    <title>{title}</title>
    <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/assets/fonts/barlow-condensed-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/libre-baskerville-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/assets/auth-gate.css" />
    <link rel="stylesheet" href="/assets/checkout.css" />
    <link rel="stylesheet" href="/assets/blank-colors.css" />
    <script is:inline src="/assets/layout.js"></script>
    <script is:inline src="/assets/env-config.js"></script>
    <script is:inline src="/assets/auth-gate.js"></script>
    <script is:inline src="/assets/cart.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand-lockup" href="/">
        <img class="brand-crown" src="/assets/royal-mark.svg" alt="" />
        <span><b>The Royal House of Engagement</b><small>Purveyed by Low Value Content</small></span>
      </a>
      <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-navigation">Menu</button>
      <nav id="site-navigation" aria-label="Primary navigation">
        {nav.map(([id, href, label]) => <a href={href} aria-current={current === id ? "page" : undefined}>{label}</a>)}
        <a class="cart-link" href="/cart.html" aria-current={current === "cart" ? "page" : undefined}>Cart <span class="cart-count" data-cart-count hidden></span></a>
      </nav>
    </header>
    <div class="page-scroll" id="page-scroll">
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-brand">
        <a class="footer-house" href="/">
          <img src="/assets/royal-mark.svg" alt="" />
          <span><b>The Royal House of Engagement</b><small>The Most Ancient and Most Serene</small></span>
        </a>
        <p><i>Low Value Content</i><br />Purveyor to the House and official issuer of its regalia.</p>
      </div>
      <div class="footer-column">
        <p class="footer-heading">The estate</p>
        <nav aria-label="Explore the Royal House of Engagement">
          <a href="/realm.html">Realm</a>
          <a href="/lineage.html">Lineage</a>
          <a href="/calendar.html">Calendar</a>
          <a href="/shop.html">Regalia</a>
          <a href="/about.html">About</a>
        </nav>
      </div>
      <div class="footer-column">
        <p class="footer-heading">Practical matters</p>
        <nav aria-label="Legal and support">
          <a href="/support.html">Support</a>
          <a href="/shipping.html">Shipping</a>
          <a href="/returns.html">Returns</a>
          <a href="/terms.html">Terms</a>
          <a href="/cookies.html">Cookies</a>
          <a href="/privacy.html">Privacy</a>
        </nav>
      </div>
      <div class="footer-social">
        <p class="footer-heading">Follow the court</p>
        <div>
          <a href="/social.html#instagram" aria-label="Instagram plans"><img src="/assets/icon-instagram.svg" alt="" /></a>
          <a href="/social.html#tiktok" aria-label="TikTok plans"><img src="/assets/icon-tiktok.svg" alt="" /></a>
          <a href="/social.html#linkedin" aria-label="LinkedIn plans"><img src="/assets/icon-linkedin.svg" alt="" /></a>
        </div>
        <a class="social-note" href="/social.html">Social proclamations →</a>
      </div>
      <p class="legal">© 2026 Low Value Content, an imprint of Nelson Grey LLC. All rights reserved.</p>
    </footer>
    </div>
    <script is:inline src="/assets/site.js" defer></script>
  </body>
</html>

<style is:global>
  @font-face { font-family: 'Barlow Condensed'; font-weight: 800; font-style: normal; font-display: swap; src: url('/assets/fonts/barlow-condensed-800.woff2') format('woff2'); }
  @font-face { font-family: 'Libre Baskerville'; font-weight: 400; font-style: normal; font-display: swap; src: url('/assets/fonts/libre-baskerville-400.woff2') format('woff2'); }
  @font-face { font-family: 'Libre Baskerville'; font-weight: 400; font-style: italic; font-display: swap; src: url('/assets/fonts/libre-baskerville-400-italic.woff2') format('woff2'); }
  @font-face { font-family: 'Libre Baskerville'; font-weight: 700; font-style: normal; font-display: swap; src: url('/assets/fonts/libre-baskerville-700.woff2') format('woff2'); }
  :root {
    --site-content-width: 80rem;
    --navy: #0d1c2b;
    --navy-2: #142b40;
    --ink: #17202a;
    --gold: #ba8d3a;
    --gold-light: #dabf83;
    --ivory: #f4eedf;
    --paper: #fbf7ed;
    --crimson: #852e34;
    --blue: #476e8f;
    --line: rgba(186, 141, 58, .42);
    --serif: 'Libre Baskerville', Georgia, 'Times New Roman', serif;
    --display: 'Barlow Condensed', 'Arial Narrow', Impact, sans-serif;
    --sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    --script: 'Snell Roundhand', 'Apple Chancery', cursive;
    /* One inset for everything. Header and footer are full width, but their content sits at the
       column's inner edge, the same line the page content uses (main redefines --gutter to the inset alone). */
    --page-pad: clamp(1.25rem, 5vw, 5rem);
    --gutter: calc(max(0px, (100% - var(--site-content-width)) / 2) + var(--page-pad));
    --header-h: 92px;      /* pinned header height; sticky elements inside the page offset by it on small screens */
    --stick-top: var(--header-h);
    --sbw: 0px;            /* classic scrollbar width, measured by /assets/layout.js */
    --fs-h1: clamp(2.9rem, 6.2vw, 5.75rem);
    --fs-h2: clamp(2.2rem, 4.2vw, 4rem);
  }
  .current-reign .latin, .realm-hero .latin, .lineage-hero .latin, .page-hero .latin, .doctrine .latin, .universal-peerage .latin, .arms-panel .latin { color: var(--gold-light); }
  h1, h2, h3 { text-wrap: balance; }
  p, li { text-wrap: pretty; }
  h1 .script, h2 .script, h1 i, h2 i { display: block; font: inherit; font-style: normal; color: var(--crimson); text-transform: uppercase; text-wrap: wrap; }
  p.script { margin: 0; font: 700 .72rem/1.3 var(--sans); letter-spacing: .18em; text-transform: uppercase; }
  :focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }
  ::selection { background: var(--crimson); color: var(--ivory); }
  /* Shared page system. Display headings are Barlow Condensed caps everywhere, as on the homepage. */
  .plain-page { padding: clamp(3rem, 6vw, 5rem) var(--gutter) clamp(4rem, 7vw, 6.5rem); min-height: 62vh; background: #fff; }
  .plain-page > header, .plain-page > .intro { max-width: 60rem; }
  .plain-page .script { margin: 0 0 .5rem; font: 700 .72rem/1.3 var(--sans); letter-spacing: .18em; text-transform: uppercase; color: var(--crimson); }
  .plain-page h1 { margin: .6rem 0 1.25rem; font: 800 clamp(2.8rem, 6.4vw, 5.25rem)/.92 var(--display); text-transform: uppercase; letter-spacing: -.005em; color: var(--navy); }
  .plain-page .lead, .plain-page header > p:last-child, .plain-page .intro > p:last-child { max-width: 44rem; margin: 0; font-size: 1.125rem; line-height: 1.7; color: #2c3640; }
  .plain-page .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; margin: 2rem 0 0; }
  .text-link { font: 700 .72rem/1.4 var(--sans); letter-spacing: .12em; text-transform: uppercase; color: var(--crimson); text-underline-offset: 4px; }
  .plain-page h2 { margin: 0; font: 800 1.65rem/1.05 var(--display); text-transform: uppercase; color: var(--navy); }
  .plain-page .rows { margin-top: 3rem; border-bottom: 1px solid var(--navy); }
  .plain-page .rows > section { display: grid; grid-template-columns: minmax(12rem, 1fr) 2.4fr; gap: 1rem 3rem; padding: 1.75rem 0; border-top: 1px solid var(--navy); }
  .plain-page .rows p { margin: 0; max-width: 44rem; line-height: 1.75; }
  .plain-page .columns { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3rem; margin-top: 3.5rem; padding-top: 2.5rem; border-top: 1px solid var(--navy); }
  .plain-page .columns h2 { margin-bottom: .75rem; }
  .plain-page .columns p { margin: 0; line-height: 1.7; }
  @media (max-width: 860px) { .plain-page .columns { grid-template-columns: 1fr; gap: 2rem; } }
  @media (max-width: 760px) { .plain-page .rows > section { grid-template-columns: 1fr; } }
  * { box-sizing: border-box; }
  html { background: #fff; color: var(--ink); scroll-behavior: smooth; }
  body { margin: 0; background: #fff; font-family: var(--serif); }
  /* Layout rule: all page content and every section background live in one centered 1280px column; outside it the page is white. */
  main { max-width: var(--site-content-width); margin-inline: auto; background: #fff; --gutter: var(--page-pad); }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  img { max-width: 100%; display: block; }
  a { color: inherit; }
  .skip-link { position: fixed; left: 1rem; top: -5rem; z-index: 30; background: white; padding: .75rem 1rem; }
  .skip-link:focus { top: 1rem; }
  .site-header { position: sticky; top: 0; z-index: 20; min-height: var(--header-h); padding: 1rem var(--gutter); display: flex; align-items: center; justify-content: space-between; gap: 2rem; background: var(--navy); color: var(--ivory); border-bottom: 1px solid rgba(218,191,131,.35); }
  .brand-lockup { display: flex; align-items: center; gap: .85rem; text-decoration: none; letter-spacing: .04em; }
  .brand-lockup b { display: block; text-transform: uppercase; font-size: .95rem; }
  .brand-lockup small { display: block; color: var(--gold-light); font-style: italic; margin-top: .2rem; }
  .brand-crown { width: 34px; height: 34px; object-fit: contain; }
  .site-header nav { display: flex; align-items: center; gap: 1.4rem; font-family: var(--sans); font-size: .78rem; text-transform: uppercase; letter-spacing: .12em; }
  .site-header nav a { color: rgba(244,238,223,.8); text-decoration: none; padding: .5rem 0; border-bottom: 1px solid transparent; }
  .site-header nav a:hover, .site-header nav a[aria-current='page'] { color: white; border-color: var(--gold); }
  .menu-button { display: none; border: 1px solid var(--gold); background: transparent; color: var(--ivory); padding: .65rem .9rem; font: inherit; }
  .site-footer { background: var(--navy); color: var(--ivory); padding: 4rem var(--gutter) 2rem; display: grid; grid-template-columns: minmax(260px, 1.5fr) .7fr .8fr .8fr; gap: clamp(2rem, 4vw, 4.5rem); border-top: 4px double var(--gold); }
  .footer-brand { display: block; }
  .footer-house { display: flex; align-items: center; gap: .85rem; width: fit-content; text-decoration: none; }
  .footer-house img { width: 48px; height: 48px; }
  .footer-house b { display: block; color: var(--ivory); font-size: .95rem; font-weight: 400; letter-spacing: .06em; text-transform: uppercase; }
  .footer-house small { display: block; margin-top: .25rem; color: var(--gold-light); font-family: var(--script); font-size: .9rem; }
  .site-footer .footer-brand > p { max-width: 340px; margin-top: 2.75rem; font: 400 .65rem/1.55 var(--sans); }
  .footer-brand > p i { font-size: inherit; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }
  .site-footer p { margin: 0; line-height: 1.55; color: rgba(244,238,223,.72); }
  .site-footer i { color: var(--gold-light); }
  .footer-heading { margin-bottom: 1rem !important; color: var(--gold-light) !important; font: 700 .66rem/1.3 var(--sans); letter-spacing: .16em; text-transform: uppercase; }
  .site-footer nav { display: grid; gap: .65rem; font-family: var(--sans); font-size: .78rem; }
  .site-footer nav a { text-decoration: none; }
  .site-footer nav a:hover, .site-footer nav a:focus-visible, .social-note:hover, .social-note:focus-visible { color: white; text-decoration: underline; text-underline-offset: 4px; }
  .footer-social > div { display: flex; gap: .65rem; }
  .footer-social > div a { width: 38px; height: 38px; border: 1px solid rgba(218,191,131,.45); border-radius: 50%; display: grid; place-items: center; }
  .footer-social > div a:hover, .footer-social > div a:focus-visible { background: var(--crimson); border-color: var(--gold-light); }
  .footer-social img { width: 19px; height: 19px; }
  .social-note { display: inline-block; margin-top: 1rem; color: rgba(244,238,223,.7); font: .72rem/1.4 var(--sans); text-decoration: none; }
  .legal { grid-column: 1 / -1; border-top: 1px solid rgba(255,255,255,.15); padding-top: 1.2rem; font: .72rem/1.5 var(--sans); }
  .eyebrow { font: 700 .72rem/1.3 var(--sans); text-transform: uppercase; letter-spacing: .18em; color: var(--crimson); }
  .script { font-family: var(--script); font-size: 1.35em; font-weight: 400; color: var(--crimson); }
  .latin { text-transform: uppercase; letter-spacing: .16em; font-size: .74rem; color: var(--gold-text); }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: .55rem; padding: .9rem 1.25rem; border: 1px solid var(--gold); background: var(--navy); color: white; text-decoration: none; font: 700 .75rem/1 var(--sans); letter-spacing: .11em; text-transform: uppercase; cursor: pointer; }
  .button:hover { background: var(--crimson); }
  .button.light { background: var(--ivory); color: var(--navy); }
  .button.ghost { background: transparent; color: var(--navy); }
  .section { padding: clamp(3.75rem, 6.5vw, 7rem) var(--gutter); }
  .section-heading { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: .5rem clamp(2rem, 5vw, 5rem); align-items: end; margin-bottom: 3rem; }
  .section-heading > .eyebrow { grid-column: 1 / -1; margin: 0; }
  .section-heading h2 { font: 800 clamp(2.2rem, 4.4vw, 3.5rem)/.98 var(--display); text-transform: uppercase; color: var(--navy); margin: 0; }
  .section-heading p:last-child { max-width: 34rem; margin: 0; font-size: 1.08rem; line-height: 1.7; }
  @media (max-width: 860px) { .section-heading { grid-template-columns: minmax(0, 1fr); } .section-heading p:last-child { margin-top: .75rem; } }
  /* Wide screens: the header is pinned and only the body (main + footer) scrolls, so the scrollbar sits under
     the header and the header never changes width between short and long pages. */
  @media (min-width: 801px) {
    :root { --stick-top: 0px; }
    html, body { height: 100%; overflow: hidden; }
    body { display: flex; flex-direction: column; }
    .site-header {
      flex: none;
      --g: calc(max(0px, (100% - var(--sbw) - var(--site-content-width)) / 2) + var(--page-pad));
      padding-left: var(--g);
      padding-right: calc(var(--g) + var(--sbw));
    }
    .page-scroll { flex: 1 1 auto; min-height: 0; overflow-y: scroll; overflow-x: hidden; scroll-behavior: smooth; overscroll-behavior: contain; }
    .page-scroll:focus { outline: none; }
  }
  @media (min-width: 801px) and (prefers-reduced-motion: reduce) { .page-scroll { scroll-behavior: auto; } }
  @media print {
    html, body { height: auto; overflow: visible; }
    .page-scroll { overflow: visible; }
    .site-header { position: static; }
  }
  @media (max-width: 800px) {
    .menu-button { display: block; }
    .site-header nav { display: none; position: absolute; left: 0; right: 0; top: 100%; padding: 1.25rem; background: var(--navy); flex-direction: column; align-items: stretch; border-top: 1px solid var(--line); }
    .site-header nav.open { display: flex; }
    .brand-lockup small { display: none; }
    .site-footer { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
    .legal { grid-column: 1; }
  }
  @media (max-width: 520px) {
    .site-footer { grid-template-columns: 1fr; }
    .footer-brand, .legal { grid-column: 1; }
  }
</style>
