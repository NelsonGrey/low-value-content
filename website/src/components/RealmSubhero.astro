---
interface Props { title: string; lead: string; kicker?: string; }
const { title, lead, kicker = "The Realm" } = Astro.props;
---
<header class="realm-subhero">
  <p class="kicker">{kicker}</p>
  <h1 set:html={title} />
  <p class="lead">{lead}</p>
</header>
<style>
  .realm-subhero { background: var(--navy); color: var(--ivory); padding: clamp(2.5rem, 5vw, 4.5rem) var(--gutter) clamp(2rem, 4vw, 3.5rem); }
  .kicker { margin: 0 0 .75rem; color: var(--gold-light); font: 700 .72rem/1.3 var(--sans); letter-spacing: .16em; text-transform: uppercase; }
  .realm-subhero h1 { margin: 0 0 1.25rem; font: 800 clamp(2.8rem, 7vw, 5.5rem)/.92 var(--display); text-transform: uppercase; letter-spacing: -.005em; }
  .lead { margin: 0; max-width: 44rem; font-size: 1.15rem; line-height: 1.7; color: rgba(244, 238, 223, .86); }
</style>
